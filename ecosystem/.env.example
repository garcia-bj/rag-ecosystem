# ============================================================
# SERVICIOS EXTERNOS (Dokploy — 147.93.1.182)
# ============================================================

# PostgreSQL (external)
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=rag_metadata
POSTGRES_LANGFUSE_DB=langfuse
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Qdrant (external)
QDRANT_URL=http://your-qdrant-host:6333
QDRANT_API_KEY=CHANGE_ME_qdrant_api_key

# Redis (external)
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://default:${REDIS_PASSWORD}@your-redis-host:6379
REDIS_LANGFUSE_URL=redis://default:${REDIS_PASSWORD}@your-redis-host:6379/1

# RustFS / S3 (external)
S3_ENDPOINT=http://your-rustfs-host
S3_ACCESS_KEY=CHANGE_ME_rustfs_access_key
S3_SECRET_KEY=CHANGE_ME_rustfs_secret_key
S3_BUCKET=langfuse         # bucket usado por Langfuse (no cambiar)
S3_RAG_BUCKET=rag-documents  # bucket para documentos RAG (separado de Langfuse)
S3_REGION=us-east-1

# ============================================================
# SERVICIOS LOCALES (Docker Compose)
# ============================================================

# Neo4j (Graph DB)
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password

# Elasticsearch (BM25 Keyword Search)
ES_JAVA_OPTS=-Xms12g -Xmx12g
ES_PORT=9200

# RabbitMQ (Message Queue)
RABBITMQ_USER=rag_rabbit
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
RABBITMQ_VHOST=rag

# ClickHouse (Langfuse Analytics)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_password

# ============================================================
# LANGFUSE (Observability)
# ============================================================
LANGFUSE_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
LANGFUSE_SALT=CHANGE_ME_generate_with_openssl_rand_base64_32
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_must_be_exactly_64_hex_chars
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME

# ============================================================
# TRAEFIK (Reverse Proxy / TLS)
# ============================================================
ACME_EMAIL=admin@your-domain.com
DOMAIN=your-domain.com

# ============================================================
# LLM PROVIDER KEYS (para fases futuras)
# ============================================================
OPENAI_API_KEY=sk-CHANGE_ME
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
GOOGLE_API_KEY=CHANGE_ME_gemini_key
MISTRAL_API_KEY=CHANGE_ME_mistral_key

# OCR backend for images and scanned PDFs: "mistral" | "gemini" | "none"
# Auto-detected: uses mistral if MISTRAL_API_KEY is set, otherwise gemini
OCR_BACKEND=mistral
MISTRAL_OCR_MODEL=mistral-ocr-latest
OCR_MIN_CHARS_PER_PAGE=50

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
